# Teleport state: contains private keys and the cluster database.
data/

# Join tokens and other secrets.
secrets/

# Teleport client binaries (downloaded, checksum-verified).
bin/

# tbot output certificates (short-lived credentials).
tbot/out/

# Synthetic demo data (regenerate with scripts/gen_demo_events.py)
demo-data/

# Python bytecode (regenerated automatically)
__pycache__/

# Splunk app dashboards live in a folder named "data": keep them in Git
# (the plain "data/" rule above would otherwise hide them).
!splunk/apps/teleport_lab/default/data/
